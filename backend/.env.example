# Скопируй этот файл в .env и заполни значения
DATABASE_URL=postgresql://planner:planner@postgres:5432/planner_db
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Separate Fernet key, generated once and securely backed up. Required to enroll/use TOTP.
# Generate with cryptography.fernet.Fernet.generate_key(); see docs/two_factor_auth.md.
MFA_ENCRYPTION_KEY=
# Password reset email. Keep credentials private; see docs/password_reset.md.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS_MODE=ssl
PASSWORD_RESET_URL=https://gethubaboba.github.io/AI_Calendar_App_Personal/reset-password/
# Browser origin only: do not include the /AI_Calendar_App_Personal Pages path.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://gethubaboba.github.io
